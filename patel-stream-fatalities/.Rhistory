# Beobachtete Häufigkeiten
beobachtete_haeufigkeiten <- table(daten$Augenfarbe)
# Berechnung der theoretischen (erwarteten) Häufigkeiten
gesamtanzahl <- sum(beobachtete_haeufigkeiten)
anzahl_kategorien <- length(beobachtete_haeufigkeiten)
theoretische_haeufigkeit_pro_kategorie <- gesamtanzahl / anzahl_kategorien
# Erstellen einer Tabelle mit den theoretischen Häufigkeiten für jede Augenfarbe
theoretische_haeufigkeiten <- rep(theoretische_haeufigkeit_pro_kategorie, anzahl_kategorien)
names(theoretische_haeufigkeiten) <- names(beobachtete_haeufigkeiten)
# Ausgabe der theoretischen Häufigkeitstabelle
print("Theoretische Häufigkeitstabelle")
print(theoretische_haeufigkeiten)
