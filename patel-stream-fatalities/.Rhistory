max_val <- max(daten$`Körpergröße (cm)`)
axis_ticks <- seq(from = floor(min_val/5)*5, to = ceiling(max_val/5)*5, by = 5)
axis(side = 1, at = axis_ticks)
max_count <- max(table(cut(daten$`Körpergröße (cm)`, breaks=klasseneinteilung)))
max_count <- round(max_count/10)*10
y_axis_ticks <- seq(0, max_count, by = 5)
axis(side = 4, at = y_axis_ticks, labels = TRUE) # labels are set to FALSE to avoid duplicating the tick labels
klasseneinteilung <- ceiling(1 + 3.322 * log10(length(daten$`Körpergröße (cm)`))) # Klasseneinteilung nach Sturges
hist(daten$`Körpergröße (cm)`, breaks=klasseneinteilung, main = "Histogramm der Körpergröße", xlab = "Körpergröße", ylab="Anzahl")
